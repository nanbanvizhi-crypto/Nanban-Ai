<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DarkActionBar (not NoActionBar) so the top bar shows the ⋮ menu with
         "Reload" and "Change server URL" — most phones have no hardware menu key. -->
    <style name="Theme.Nanban" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/nanban_accent</item>
        <item name="colorPrimaryDark">@color/nanban_accent</item>
        <item name="colorAccent">@color/nanban_accent</item>
        <item name="android:windowBackground">@color/nanban_bg</item>
        <item name="android:statusBarColor">@color/nanban_accent</item>
    </style>
</resources>
