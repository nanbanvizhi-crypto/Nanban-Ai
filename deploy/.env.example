# Copy to .env and fill in. NEVER commit the real .env (it's in .gitignore).
# On a host (Render/HF/Railway), set these as environment variables in the dashboard instead.

# --- Model API (any OpenAI-compatible provider) ---
# Groq (free tier, fast):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# Together: LLM_BASE_URL=https://api.together.xyz/v1
LLM_API_KEY=put-your-key-here

# --- Optional ---
APP_PASSWORD=            # set a password to gate the public app (login user: nanban)
AGENT_NAME=Nanban
PORT=7860
