# ============================================================
#  Nanban cloud config — copy this file to ".env" and fill it in
# ============================================================

# --- The AI brain: a FREE hosted model (no GPU needed) ---
# Get a free key:
#   Groq   -> https://console.groq.com   (fast, free)
#   NVIDIA -> https://build.nvidia.com   (top models, free key)
NANBAN_LLM_BACKEND=hosted

# Groq (default). For NVIDIA use:
#   NANBAN_HOSTED_BASE_URL=https://integrate.api.nvidia.com/v1
#   NANBAN_HOSTED_MODEL=meta/llama-3.3-70b-instruct
NANBAN_HOSTED_BASE_URL=https://api.groq.com/openai/v1
NANBAN_HOSTED_MODEL=openai/gpt-oss-20b
NANBAN_HOSTED_API_KEY=PASTE_YOUR_KEY_HERE

# --- Login (REQUIRED — this keeps your public app private) ---
# Format: user:password , comma-separated for more users.
NANBAN_USERS=dev:CHANGE-THIS-STRONG-PASSWORD
NANBAN_ADMIN_USERS=dev

# --- Safety on a public server (leave these off) ---
NANBAN_WEB_COMPUTER_MODE=false
NANBAN_SECURITY_TAB=false
NANBAN_AUTOSTART_LAB=false

# --- Optional: keys for the OpenAI-compatible API at /v1 (comma-separated) ---
# NANBAN_API_KEYS=nanban-sk-make-this-long-and-random

# Port — most hosts inject $PORT automatically; 8000 is a safe default.
PORT=8000
